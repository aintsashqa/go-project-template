# Levels: Debug = -4, Info = 0, Warning = 4, Error = 8
# LOG_LEVEL=-4

# HTTP_PORT=50051
# HTTP_READ_TIMEOUT=1s
# HTTP_WRITE_TIMEOUT=1s
# HTTP_IDLE_TIMEOUT=30s

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=_database_name

POSTGRES_MULTIPLE_DATABASES=${POSTGRES_DB}

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
GOOSE_MIGRATION_DIR=./migrations
